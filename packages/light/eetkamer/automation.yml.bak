- id: licht_eetkamer_schakel_aan_vol
  alias: "schakel lichten eetkamer aan"
  description: "Schakel de lichten aan (vol) als deze uit staat"
  initial_state: true
  mode: restart
  trigger:
    - id: schakelaar_eetkamer
      platform: state
      entity_id:
        - switch.schakelaar_eetkamer
      from: null
  condition:
    - condition: state
      entity_id: input_select.licht_eetkamer
      state: "uit"
  action:
    - action: scene.turn_on
      target:
        entity_id: scene.vol_licht_eetkamer

- id: licht_eetkamer_schakel_uit
  alias: "schakel lichten eetkamer uit"
  description: "Schakel de lichten uit als deze aanstaan"
  initial_state: true
  mode: restart
  trigger:
    - id: schakelaar_eetkamer
      platform: state
      entity_id:
        - switch.schakelaar_eetkamer
      from: null
  condition:
    - alias: "if lights are not off"
      condition: not
      conditions:
        - condition: state
          entity_id: input_select.licht_eetkamer
          state: "uit"
  action:
    - action: scene.turn_on
      target:
        entity_id: scene.licht_uit_eetkamer

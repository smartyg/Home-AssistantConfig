# .yamllint
extends: default

rules:
  # 1. Niet verplicht om met '---' te beginnen
  document-start: disable

  # 2. Voorkom fouten bij lange Jinja-templates of URL's
  line-length:
    max: 160
    level: warning
    allow-non-breakable-words: true

  # 3. Home Assistant gebruikt vaak 'on', 'off', 'yes', 'no'
  truthy: disable

  # 4. Voorkom gezeur over spaties in je commentaarregels
  comments:
    level: warning
  comments-indentation: disable

  # 5. Geen harde fouten op onnodige spaties aan het lijneinde
  trailing-spaces:
    level: warning

  # 6. Sta extra lege regels toe (handig bij UI-gegenereerde code)
  empty-lines:
    max: 5          # Standaard is 2, verhoog dit naar wens
    max-end: 2      # Aantal toegestane lege regels aan het eind van het bestand